# Copy this file to ".env" and fill in real values.
# ".env" is git-ignored and must never be committed.

# Secret used to sign JWT tokens. MUST be at least 32 characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-random-string-of-at-least-32-chars

# Access token lifetime, minutes
JWT_TTL_MINUTES=30

# SQLite database file (created automatically, relative to the repo root)
DB_PATH=data/app.db

# bcrypt cost factor (higher = slower = harder to brute-force)
BCRYPT_ROUNDS=12

# Login throttling: max failed attempts per IP+username inside the window
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300

# Set to 0 to disable self-registration (recommended outside the lab)
ALLOW_REGISTRATION=1
